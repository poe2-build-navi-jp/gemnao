{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gemnao",
  "pages_build_output_dir": "./dist/client",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "DISCORD_ADMIN_TOKEN_HASH": "0c4479af1efa03b26dde9060d78581cd856a7683807ca61475cf59dedbc6d4c5",
    "DIAGNOSIS_LOCAL_BETA": "false",
    "DIAGNOSIS_ENABLED": "true",
    "DIAGNOSIS_STORAGE_ENABLED": "true",
    "DIAGNOSIS_SHARING_ENABLED": "true",
    "DIAGNOSIS_WRITES_ENABLED": "true",
    "DIAGNOSIS_METRICS_ENABLED": "false",
    "FEEDBACK_ENABLED": "true",
    "GAME_REQUEST_REVIEW_MODE": "manual",
    "GAME_REQUEST_MANUAL_REVIEW_READY": "true",
    "GAME_REQUESTS_ENABLED": "true",
    "REPORTS_ENABLED": "true",
    "REPORTS_PUBLIC_ENABLED": "true",
    "REPORTS_REVIEW_ENABLED": "true",
    "REPORTS_BUDGET_VERIFIED": "true",
    "REPORTS_AUTO_OBSERVATION_ENABLED": "false",
    "REPORTS_USAGE_PROFILE_VERIFIED": "false",
    "REPORTS_PUBLIC_MONITOR_VERIFIED": "true",
    "REPORTS_BOOTSTRAP_ALLOWED": "false",
    "REPORTS_VERIFICATION_ALLOWED": "false",
    "REPORTS_GUARD_INSTANCE": "c3cdfc3f-6ba1-495e-b3fd-a377b610b25e",
    "REPORTS_BUDGET_MODE": "free-small-v1",
    "REPORTS_MONITOR_MODE": "public-status"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gemnao-db",
      "database_id": "385a194f-5119-4bbe-9afe-2e6ce4ceb341",
      "migrations_dir": ".openai/drizzle",
      "migrations_table": "d1_migrations"
    },
    {
      "binding": "DIAGNOSIS_DB",
      "database_name": "gemnao-diagnosis-production",
      "database_id": "1ef1f798-7518-4b1a-a5a6-4f6f7dddfcfe"
    },
    {
      "binding": "FEEDBACK_DB",
      "database_name": "gemnao-diagnostic-feedback-production",
      "database_id": "f3379342-bb5e-461c-bad3-1175be8836c5"
    },
    {
      "binding": "REPORTS_DB",
      "database_name": "gemnao-community-reports-production",
      "database_id": "3141aae6-8dc9-47e9-a8a2-7a05f642f94f"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "DISCORD_ADMIN_TOKEN_HASH": "0c4479af1efa03b26dde9060d78581cd856a7683807ca61475cf59dedbc6d4c5",
        "DIAGNOSIS_LOCAL_BETA": "true"
      },
      "d1_databases": []
    }
  },
  "services": [
    {
      "binding": "REPORTS_GUARD",
      "service": "gemnao-community-reports-guard",
      "environment": "production",
      "entrypoint": "ReportsGuardService"
    }
  ]
}
